# ---- predict.fun -------------------------------------------------------------
# Backtests, recorder and the bot in PAPER mode need only PREDICT_API_KEY.
# PREDICT_ACCOUNT / PREDICT_PRIVATE_KEY are needed only for real orders (terminal, --live).
# API key: predict.fun developer dashboard (create an app -> generate key)
PREDICT_API_KEY=

# Email / social login ("Predict account"):
#   PREDICT_ACCOUNT     = deposit address of the account (Settings on predict.fun)
#   PREDICT_PRIVATE_KEY = Privy wallet private key (Settings -> export wallet)
# Own wallet (Rabby / MetaMask): leave PREDICT_ACCOUNT empty, put that wallet's key below.
PREDICT_ACCOUNT=
PREDICT_PRIVATE_KEY=

# ---- terminal ----------------------------------------------------------------
# hard cap for one click (USDT)
TERMINAL_MAX_ORDER_USDT=50
TERMINAL_DEFAULT_SIZE_USDT=5
TERMINAL_SIZE_PRESETS=2,5,10,25,50
# taker orders may fill this many ticks past the clicked price (0 = never worse than the click)
TERMINAL_SLIPPAGE_TICKS=0
# market series: slug prefix:period seconds
TERMINAL_MARKETS=btc-updown-5m:300,btc-updown-15m:900
TERMINAL_CHART_MINUTES=20
TERMINAL_HOST=127.0.0.1
TERMINAL_PORT=8765
